# Merge and patch leftovers from a half-applied conflict resolution.
*.rej
*.orig
ios/
android/

# NestJS
coverage/
.nestjs/

# Environment
# Every real environment file is ignored; only the documented template is kept.
.env
.env.*
!.env.example

# Prisma
prisma/*.db
prisma/*.db-journal
prisma/generated/

# Local media storage
# Runtime upload directory for the local development media provider
# (MEDIA_UPLOAD_DIR). These are user-supplied files, not source, so they are
# never committed. A production media provider writes to its own store instead.
backend/api/uploads/
uploads/
# Private uploads (PRIVATE_MEDIA_UPLOAD_DIR) hold identity documents - Aadhaar,
# licences - which must never reach a repository at all. The directory name does
# not match the `uploads/` pattern above, so it needs its own entry rather than
# relying on a wildcard.
backend/api/private-uploads/
private-uploads/

# Local database tooling
*.sqlite
*.sqlite3
.pgpass
pgpass
# Dumps produced by pg_dump / pg_dumpall / pgAdmin. A dump contains every row,
# including password hashes and the personal data of real accounts, so it has no
# business in the repository even for a development database.
*.dump
*.backup
*.sql.gz
*.tar.gz
backend/api/prisma/*.dump

# Testing
coverage-final.json
test-results/
playwright-report/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors / OS
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db
.eslintcache

# Local tooling
.kilo/

# Local generated audit reports
# Working documents produced by review tooling, kept locally for the record.
# They are not project documentation and are never part of the repository.
HELPZY_FINAL_AUDIT.md

