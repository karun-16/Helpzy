# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-android/
dist-ios/
build/
.next/
out/
*.tsbuildinfo

# Expo
.expo/
.expo-shared/
web-build/
expo-env.d.ts
*.jks
*.p8
*.p12
*.key
