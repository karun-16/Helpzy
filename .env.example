# ==============================================================================
# HELPZY - Environment configuration (single source of truth)
# ==============================================================================
# Copy this file to `.env` in the repository root and fill in real values.
#   cp .env.example .env
#
# Rules:
#  - NEVER commit a real `.env` file. `.env` is git-ignored.
#  - NEVER put production secrets in this file. Development placeholders only.
#  - Every variable prefixed with EXPO_PUBLIC_ is exposed to the frontend
#    bundle by design. Never put a secret behind that prefix.
# ==============================================================================

# ------------------------------------------------------------------------------
# General
# ------------------------------------------------------------------------------
NODE_ENV=development
TZ=Asia/Kolkata
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# API (backend/api - NestJS)
# ------------------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Global prefix for every REST route (health included).
API_GLOBAL_PREFIX=api/v1
# Comma separated list of allowed browser origins. Environment driven - no
# wildcard is ever accepted, because this API is credentialed.
#
#   http://localhost:8081  /  http://127.0.0.1:8081  -> CANONICAL dev origin
#                           Expo web dev server (`pnpm dev:web`).
#   http://localhost:19006 /  http://127.0.0.1:19006  -> Expo Go / dev client
#                           (physical device, `pnpm dev:android` / `dev:ios`).
#   http://localhost:3000  /  http://127.0.0.1:3000   -> static web export
#                           preview (`pnpm build:web` + any static server on
#                           port 3000). Needed because a static server picks
#                           its own port, and the origin must match exactly.
#
# `localhost` and `127.0.0.1` are different origins to a browser, so both are
# listed. If you serve a preview on a different port, add that port here rather
# than switching the allow-list off.
API_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Database (PostgreSQL + Prisma) - available from PHASE 2
# ------------------------------------------------------------------------------
# Local development only. Create the role and database once, then run
#   pnpm --filter @helpzy/api run db:migrate
#   pnpm --filter @helpzy/api run db:seed
# See docs/phase-02-database.md.
DATABASE_URL=postgresql://helpzy:helpzy_dev_password@localhost:5432/helpzy?schema=public

# ------------------------------------------------------------------------------
# Frontend (apps/frontend - Expo, shared by web / android / ios)
# ------------------------------------------------------------------------------
# Base URL of the backend API used by @helpzy/api-client.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
# Timeout for outgoing API requests (milliseconds).
EXPO_PUBLIC_API_TIMEOUT_MS=15000
# Brand
EXPO_PUBLIC_APP_NAME=HELPZY
EXPO_PUBLIC_APP_TAGLINE=Find the Right Service, Right Around You
