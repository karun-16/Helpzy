// HELPZY - Prisma schema
//
// Design rules:
//  - Enum values mirror `packages/types/src/enums.ts` exactly. The shared
//    package is the source of truth for the domain vocabulary; this file is the
//    source of truth for persistence. They must not drift.
//  - Money is `Decimal(10, 2)`, never a float.
//  - Timestamps are stored in UTC (`timestamptz`).
//  - Every model carries `createdAt` / `updatedAt`.
//  - Soft deletes are avoided; `User.status` already expresses deactivation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  PROFESSIONAL
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  SCHEDULED
  ON_THE_WAY
  IN_PROGRESS
  COMPLETED_BY_PROFESSIONAL
  CUSTOMER_CONFIRMED
  PAYMENT_PENDING
  PAID
  CLOSED
  REJECTED
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  DIRECT
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum NotificationType {
  BOOKING_REQUESTED
  BOOKING_ACCEPTED
  BOOKING_REJECTED
  BOOKING_SCHEDULED
  BOOKING_ON_THE_WAY
  BOOKING_IN_PROGRESS
  BOOKING_COMPLETED
  BOOKING_CONFIRMED
  PAYMENT_PENDING
  PAYMENT_PAID
  PAYMENT_FAILED
  BOOKING_CANCELLED
  REVIEW_RECEIVED
  VERIFICATION_DECISION
  SYSTEM
}

enum AuditEntityType {
  USER
  PROFESSIONAL_PROFILE
  SERVICE
  SERVICE_CATEGORY
  BOOKING
  PAYMENT
  REVIEW
  NOTIFICATION
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String?    @unique
  phone        String?    @unique
  passwordHash String
  fullName     String
  avatarUrl    String?
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  customerProfile     CustomerProfile?
  professionalProfile ProfessionalProfile?
  addresses           Address[]
  bookingsAsCustomer  Booking[]        @relation("BookingCustomer")
  bookingStatusChanges BookingStatusHistory[] @relation("BookingStatusActor")
  services            Service[]        @relation("ServiceOwner")
  reviewsWritten      Review[]         @relation("ReviewAuthor")
  notifications       Notification[]
  auditLogs           AuditLog[]       @relation("AuditActor")
  sentMessages        BookingMessage[] @relation("MessageSender")
  uploadedMedia       MediaAsset[]     @relation("MediaOwner")

  @@index([role, status])
  @@map("users")
}

/// An uploaded file (currently profile photos) owned by a user.
///
/// The bytes live behind a `MediaStorageProvider`; this row records only the
/// provider key and the public URL that key resolves to.
model MediaAsset {
  id           String   @id @default(uuid()) @db.Uuid
  ownerUserId  String   @db.Uuid
  kind         String
  provider     String
  storageKey   String
  publicUrl    String
  contentType  String
  byteSize     Int
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  owner User @relation("MediaOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, kind], map: "media_assets_owner_kind_key")
  @@index([ownerUserId])
  @@map("media_assets")
}

model CustomerProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

/// Provider-facing data. A user has at most one profile, created when a
/// customer switches to the PROFESSIONAL role.
model ProfessionalProfile {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @unique @db.Uuid
  businessName   String
  bio            String?
  verification   VerificationStatus @default(UNVERIFIED)
  verifiedAt     DateTime?          @db.Timestamptz(3)
  rejectionNote  String?
  serviceArea    String?
  averageRating  Decimal            @default(0) @db.Decimal(3, 2)
  ratingCount    Int                @default(0)
  completedCount Int                @default(0)

  // Marketplace profile details the professional owns. All nullable so an
  // existing profile renders an honest empty state instead of invented data.
  yearsOfExperience Int?
  contactEmail      String?
  /// Phone is the login identity and is never copied here; the professional
  /// only controls whether customers may see it.
  isPhoneVisible    Boolean           @default(false)
  /// `[{ "day": 1, "start": "09:00", "end": "18:00" }]` with `day` 0=Sun..6=Sat.
  workingHours      Json?

  /// Last position reported by the professional's own device while location
  /// sharing is on. Never populated without an explicit device update.
  isLocationSharingEnabled Boolean   @default(false)
  lastKnownLatitude        Decimal? @db.Decimal(9, 6)
  lastKnownLongitude       Decimal? @db.Decimal(9, 6)
  locationUpdatedAt        DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[] @relation("BookingProfessional")

  @@map("professional_profiles")
}

model ServiceCategory {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  iconUrl     String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  services Service[]

  @@index([isActive, sortOrder])
  @@map("service_categories")
}

model Service {
  id             String   @id @default(uuid()) @db.Uuid
  ownerId        String   @db.Uuid
  categoryId     String   @db.Uuid
  title          String
  slug           String   @unique
  summary        String?
  description    String
  basePrice      Decimal  @db.Decimal(10, 2)
  currency       String   @default("INR") @db.Char(3)
  durationMinutes Int     @default(60)
  isActive       Boolean  @default(true)
  averageRating  Decimal  @default(0) @db.Decimal(3, 2)
  ratingCount    Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  owner    User            @relation("ServiceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bookings Booking[]
  reviews  Review[]

  @@index([categoryId, isActive])
  @@index([ownerId, isActive])
  @@map("services")
}

model Address {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @db.Uuid
  label      String
  type       AddressType @default(HOME)
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  latitude   Decimal?    @db.Decimal(9, 6)
  longitude  Decimal?    @db.Decimal(9, 6)
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([userId])
  @@map("addresses")
}

model Booking {
  id                String        @id @default(uuid()) @db.Uuid
  reference         String        @unique
  customerId        String        @db.Uuid
  professionalId    String        @db.Uuid
  serviceId         String        @db.Uuid
  addressId         String?       @db.Uuid
  status            BookingStatus @default(REQUESTED)
  scheduledStart    DateTime      @db.Timestamptz(3)
  scheduledEnd      DateTime      @db.Timestamptz(3)
  priceAmount       Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR") @db.Char(3)
  customerNote      String?
  cancellationNote  String?
  cancelledAt       DateTime?     @db.Timestamptz(3)
  completedAt       DateTime?     @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  customer     User                @relation("BookingCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  professional ProfessionalProfile @relation("BookingProfessional", fields: [professionalId], references: [id], onDelete: Restrict)
  service      Service             @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  address      Address?            @relation(fields: [addressId], references: [id], onDelete: SetNull)
  payment      Payment?
  review       Review?
  statusHistory BookingStatusHistory[]
  messages     BookingMessage[]
  notifications Notification[]

  // A professional cannot hold two live bookings for the same slot.
  @@unique([professionalId, scheduledStart], map: "bookings_professional_slot_key")
  @@index([customerId, status])
  @@index([professionalId, status])
  @@index([serviceId])
  @@index([status, scheduledStart])
  @@map("bookings")
}

model BookingStatusHistory {
  id          String        @id @default(uuid()) @db.Uuid
  bookingId   String        @db.Uuid
  fromStatus  BookingStatus?
  toStatus    BookingStatus
  actorUserId String        @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor   User    @relation("BookingStatusActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  bookingId         String        @unique @db.Uuid
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR") @db.Char(3)
  method            PaymentMethod @default(ONLINE)
  status            PaymentStatus @default(PENDING)
  provider          String?
  providerReference String?
  failureReason     String?
  paidAt            DateTime?     @db.Timestamptz(3)
  refundedAt        DateTime?     @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// Provider attempts, newest last. Keeps the audit trail for a payment that
  /// was retried without overwriting the previous provider reference.
  attempts PaymentAttempt[]

  @@index([status, createdAt])
  @@map("payments")
}

/// One record per interaction with a payment provider (or with the manual
/// direct-payment path). Append-only.
model PaymentAttempt {
  id          String        @id @default(uuid()) @db.Uuid
  paymentId   String        @db.Uuid
  method      PaymentMethod
  status      PaymentStatus
  provider    String?
  reference   String?
  note        String?
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@map("payment_attempts")
}

model Review {
  id            String       @id @default(uuid()) @db.Uuid
  bookingId     String       @unique @db.Uuid
  serviceId     String       @db.Uuid
  customerId    String       @db.Uuid
  rating        Int
  comment       String?
  status        ReviewStatus @default(PENDING)
  moderatedBy   String?      @db.Uuid
  moderatedAt   DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service  Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customer User    @relation("ReviewAuthor", fields: [customerId], references: [id], onDelete: Cascade)

  @@index([serviceId, status])
  @@index([status, createdAt])
  @@map("reviews")
}

/// A message inside the chat that belongs to exactly one booking.
///
/// Only the booking's customer and its assigned professional may read or post.
/// There is deliberately no conversation table: chat cannot exist outside a
/// booking, so the booking is the conversation.
model BookingMessage {
  id           String    @id @default(uuid()) @db.Uuid
  bookingId    String    @db.Uuid
  senderUserId String    @db.Uuid
  body         String
  readAt       DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender  User    @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt])
  @@index([senderUserId, readAt])
  @@map("booking_messages")
}

/// An in-app notification produced by a real backend event.
///
/// `dedupeKey` makes delivery idempotent: the same booking transition retried
/// cannot create a second notification.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String
  bookingId String?          @db.Uuid
  /// Set while the recipient has not opened it; cleared on read.
  readAt    DateTime?        @db.Timestamptz(3)
  /// Stable identity of the event, e.g. `BOOKING_ACCEPTED:<bookingId>:<userId>`.
  dedupeKey String?
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([dedupeKey], map: "notifications_dedupe_key_key")
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// Append-only record of privileged actions, for the admin audit view.
model AuditLog {
  id          String          @id @default(uuid()) @db.Uuid
  actorUserId String          @db.Uuid
  action      String
  entityType  AuditEntityType
  entityId    String?
  metadata    Json?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)

  actor User @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
