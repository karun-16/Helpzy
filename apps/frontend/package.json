{
  "name": "@helpzy/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "HELPZY frontend - one Expo codebase for web, Android and iOS.",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:web": "expo start --web",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "start": "expo start",
    "build": "expo export --platform web --output-dir dist",
    "build:web": "expo export --platform web --output-dir dist",
    "build:android": "expo export --platform android --output-dir dist-android",
    "build:ios": "expo export --platform ios --output-dir dist-ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "doctor": "expo-doctor",
    "clean": "node -e \"const fs=require('fs');for(const d of ['dist','dist-android','dist-ios','.expo'])fs.rmSync(d,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@helpzy/api-client": "workspace:*",
    "@helpzy/config": "workspace:*",
    "@helpzy/types": "workspace:*",
    "@helpzy/validation": "workspace:*",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-document-picker": "^57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.9",
    "dotenv": "^17.2.4",
    "expo-doctor": "^1.20.4",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  }
}
