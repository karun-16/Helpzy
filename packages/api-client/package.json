{
  "name": "@helpzy/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed HTTP client for the HELPZY API, shared by the Expo app (web/android/ios) and tooling.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@helpzy/config": "workspace:*",
    "@helpzy/types": "workspace:*",
    "@helpzy/validation": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
